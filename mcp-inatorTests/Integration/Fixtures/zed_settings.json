{
  "context_servers" : {
    "github-mcp" : {
      "command" : {
        "args" : [
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "path" : "npx"
      },
      "env" : {
        "GITHUB_TOKEN" : "ghp_placeholder"
      }
