{
  "mcpServers" : {
    "github-mcp" : {
      "args" : [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command" : "npx",
      "env" : {
        "GITHUB_PERSONAL_ACCESS_TOKEN" : "ghp_placeholder"
      }
    },
    "filesystem" : {
      "args" : [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp"
      ],
      "command" : "npx",
      "env" : {}
    }
  }
}
